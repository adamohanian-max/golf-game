# Copy to .env.local and fill in. .env.local is gitignored.
# Get a token at https://account.mapbox.com/access-tokens/
# A public (pk.*) token is fine for a client-side viewer; restrict it by URL in
# the Mapbox dashboard before shipping.
VITE_MAPBOX_TOKEN=pk.your_mapbox_token_here

# Google Maps Platform API key with the "Map Tiles API" enabled (for g3d.html —
# the Google Photorealistic 3D Tiles viewer). Restrict by HTTP referrer to your
# dev/prod origin in the Google Cloud console. .env.local is gitignored.
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_key_here
