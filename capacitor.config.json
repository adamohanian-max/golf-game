{
  "appId": "com.adamohanian.golf",
  "appName": "Golf",
  "webDir": "capacitor-shell",
  "server": {
    "url": "https://yo-golf.com/",
    "cleartext": false
  },
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#1b5e34"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "backgroundColor": "#1b5e34",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "overlaysWebView": true
    }
  },
  "packageClassList": [
    "HapticsPlugin",
    "SplashScreenPlugin",
    "StatusBarPlugin",
    "CourseMap3DPlugin"
  ]
}
